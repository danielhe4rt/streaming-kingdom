[obs]
host = "localhost"
port = 4455
password = "123123"
capture_source = "Screen Capture"

[twitch]
client_id = ""
oauth_token = ""
refresh_token = ""
broadcaster_user_id = ""

[alerts]
overlay_url = ""
browser_command = "firefox"

[waybar]
output = "DP-1"

[privacy]
sensitive_patterns = [".env", "credentials", ".secret", ".pem", "id_rsa"]

[event_log]
show_stream = true
show_privacy = true
show_system = true
show_hyprland = false
max_events = 100

[overlays]
# Port the Overlay http server binds on (127.0.0.1). Paste the URLs it logs
# into OBS browser sources, e.g. http://127.0.0.1:1337/overlay/chat
port = 1337
